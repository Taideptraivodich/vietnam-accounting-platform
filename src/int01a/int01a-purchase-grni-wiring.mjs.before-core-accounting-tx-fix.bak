import { createRequire } from 'node:module';
import { randomUUID } from 'node:crypto';

const require = createRequire(import.meta.url);
const { Pool } = require('pg');

function firstDefined(...values) {
  for (const value of values) {
    if (value !== undefined && value !== null && value !== '') return value;
  }
  return undefined;
}

function money(value) {
  const n = Number(value ?? 0);
  return Number.isFinite(n) ? Math.round(n * 100) / 100 : 0;
}

function isoDate(value) {
  if (!value) return new Date().toISOString().slice(0, 10);
  return String(value).slice(0, 10);
}

function periodOf(date) {
  return String(date).slice(0, 7).replace('-', '');
}

function exported(mod, name) {
  return mod?.[name] || mod?.default || mod;
}

async function query(db, text, params = []) {
  return db.query(text, params);
}

async function tableColumns(db, table) {
  const result = await query(db, `
    select column_name
    from information_schema.columns
    where table_schema = 'public' and table_name = $1
  `, [table]);
  return new Set(result.rows.map((r) => r.column_name));
}

async function insertDynamic(db, table, row) {
  const cols = await tableColumns(db, table);
  const names = Object.keys(row).filter((k) => cols.has(k) && row[k] !== undefined);
  const values = names.map((k) => row[k]);
  const quoted = names.map((k) => `"${k}"`).join(', ');
  const placeholders = names.map((_, i) => `$${i + 1}`).join(', ');
  const result = await query(db, `insert into ${table} (${quoted}) values (${placeholders}) returning *`, values);
  return result.rows[0];
}

async function firstId(db, table, companyId) {
  const result = await query(db, `select id from ${table} where company_id = $1 order by created_at nulls last, id limit 1`, [companyId]);
  return result.rows[0]?.id;
}

function createPostingService(pool) {
  const PostingService = exported(require('../services/PostingService.js'), 'PostingService');
  const JournalEntryRepository = exported(require('../repositories/JournalEntryRepository.js'), 'JournalEntryRepository');
  const GlEntryRepository = exported(require('../repositories/GlEntryRepository.js'), 'GlEntryRepository');
  const PostingValidator = exported(require('../validators/PostingValidator.js'), 'PostingValidator');
  const AccountRepository = exported(require('../repositories/AccountRepository.js'), 'AccountRepository');
  const FiscalPeriodRepository = exported(require('../repositories/FiscalPeriodRepository.js'), 'FiscalPeriodRepository');

  return new PostingService({
    journalEntryRepository: new JournalEntryRepository(pool),
    glEntryRepository: new GlEntryRepository(pool),
    postingValidator: new PostingValidator({
      accountRepository: new AccountRepository(pool),
      fiscalPeriodRepository: new FiscalPeriodRepository(pool),
    }),
    db: pool,
  });
}

async function postAccounting(pool, request) {
  const svc = createPostingService(pool);
  return svc.postAccountingDocument(request);
}

export async function postPurchaseGrni(input = {}) {
  const pool = new Pool({ connectionString: process.env.DATABASE_URL });
  try {
    const companyId = firstDefined(input.companyId, input.company_id, process.env.MD01_COMPANY_ID);
    if (!companyId) throw new Error('INT01A purchase GRNI missing companyId');

    const postingDate = isoDate(firstDefined(input.postingDate, input.posting_date));
    const supplierId = firstDefined(input.supplierId, input.supplier_id) || await firstId(pool, 'suppliers', companyId);
    const itemId = firstDefined(input.itemId, input.item_id, input.inventoryItemId, input.inventory_item_id) || await firstId(pool, 'items', companyId);
    const warehouseId = firstDefined(input.warehouseId, input.warehouse_id) || await firstId(pool, 'warehouses', companyId);

    if (!supplierId || !itemId || !warehouseId) {
      throw new Error('INT01A purchase GRNI missing supplier/item/warehouse master data');
    }

    const qty = money(firstDefined(input.quantity, input.qty, 10));
    const unitCost = money(firstDefined(input.unitCost, input.unit_cost, input.unitPrice, input.unit_price, 100));
    const amount = money(qty * unitCost);
    const currency = firstDefined(input.currency, input.currency_code, 'VND');

    const inventoryAccountId = firstDefined(input.inventoryAccountId, input.inventory_account_id, process.env.MD01_INVENTORY_ACCOUNT_ID);
    const grniAccountId = firstDefined(input.grniAccountId, input.grni_account_id, process.env.MD01_GRNI_ACCOUNT_ID);
    if (!inventoryAccountId || !grniAccountId) {
      throw new Error('INT01A purchase GRNI missing inventory/grni account env');
    }

    const baseKey = firstDefined(input.idempotencyKey, input.idempotency_key, `int01a-purchase-grni-${Date.now()}-${randomUUID()}`);
    const receiptId = randomUUID();
    const receiptLineId = randomUUID();
    const invoiceId = randomUUID();
    const invoiceLineId = randomUUID();
    const receiptNo = `INT01A-PR-${Date.now()}`;
    const invoiceNo = `INT01A-PI-${Date.now()}`;

    await insertDynamic(pool, 'purchase_receipts', {
      id: receiptId,
      company_id: companyId,
      supplier_id: supplierId,
      receipt_number: receiptNo,
      receipt_date: postingDate,
      posting_date: postingDate,
      status: 'posted',
      currency_code: currency,
      total_amount: amount,
      idempotency_key: `${baseKey}:receipt`,
      notes: 'INT-01A EW-04 purchase GRNI baseline',
      posted_at: new Date(),
    });

    await insertDynamic(pool, 'purchase_receipt_lines', {
      id: receiptLineId,
      company_id: companyId,
      purchase_receipt_id: receiptId,
      line_number: 1,
      item_id: itemId,
      warehouse_id: warehouseId,
      description: 'INT-01A purchase receipt line',
      quantity: qty,
      unit_cost: unitCost,
      line_amount: amount,
      billed_qty: qty,
    });

    await insertDynamic(pool, 'purchase_invoices', {
      id: invoiceId,
      company_id: companyId,
      supplier_id: supplierId,
      invoice_number: invoiceNo,
      invoice_date: postingDate,
      posting_date: postingDate,
      due_date: postingDate,
      status: 'posted',
      payment_method: 'credit',
      stock_update_pattern: 'receipt_then_invoice',
      currency_code: currency,
      subtotal_amount: amount,
      tax_amount: 0,
      total_amount: amount,
      received_qty: qty,
      billed_qty: qty,
      received_amount: amount,
      billed_amount: amount,
      idempotency_key: `${baseKey}:invoice`,
      notes: 'INT-01A EW-04 purchase invoice baseline',
      posted_at: new Date(),
    });

    await insertDynamic(pool, 'purchase_invoice_lines', {
      id: invoiceLineId,
      company_id: companyId,
      purchase_invoice_id: invoiceId,
      line_number: 1,
      item_id: itemId,
      warehouse_id: warehouseId,
      description: 'INT-01A purchase invoice line',
      quantity: qty,
      unit_price: unitCost,
      line_amount: amount,
      tax_rate: 0,
      tax_amount: 0,
      purchase_receipt_id: receiptId,
      purchase_receipt_line_id: receiptLineId,
    });

    const receiptPost = await postAccounting(pool, {
      company_id: companyId,
      posting_date: postingDate,
      source_document_type: 'purchase_receipt',
      source_document_id: receiptId,
      source_document_no: receiptNo,
      currency,
      idempotency_key: `${baseKey}:post-receipt`,
      lines: [
        { account_id: inventoryAccountId, debit_amount: amount, credit_amount: 0, description: 'Dr Inventory' },
        { account_id: grniAccountId, debit_amount: 0, credit_amount: amount, description: 'Cr GRNI' },
      ],
    });

    const invoicePost = await postAccounting(pool, {
      company_id: companyId,
      posting_date: postingDate,
      source_document_type: 'purchase_invoice',
      source_document_id: invoiceId,
      source_document_no: invoiceNo,
      currency,
      idempotency_key: `${baseKey}:post-invoice`,
      lines: [
        { account_id: grniAccountId, debit_amount: amount, credit_amount: 0, description: 'Dr GRNI' },
        { account_id: grniAccountId, debit_amount: 0, credit_amount: amount, description: 'Cr AP clearing' },
      ],
    });

    const invoiceAccountingDocumentId = firstDefined(invoicePost?.journal_entry_id, invoicePost?.id);
    const receiptAccountingDocumentId = firstDefined(receiptPost?.journal_entry_id, receiptPost?.id);

    await insertDynamic(pool, 'ar_ap_ledger_entries', {
      id: randomUUID(),
      company_id: companyId,
      party_type: 'supplier',
      party_id: supplierId,
      entry_type: 'invoice',
      debit_amount: 0,
      credit_amount: amount,
      currency_code: currency,
      source_document_type: 'purchase_invoice',
      source_document_id: invoiceId,
      source_document_line_id: invoiceLineId,
      posting_date: postingDate,
      accounting_period: periodOf(postingDate),
      idempotency_key: `${baseKey}:ap-ledger`,
      notes: 'INT-01A EW-04 AP outstanding',
      created_by: companyId,
    });

    const accountingDocumentIds = [receiptAccountingDocumentId, invoiceAccountingDocumentId].filter(Boolean);

    return {
      ok: true,
      surface: 'EW-04 Purchase/GRNI approved service surface',
      company_id: companyId,
      posting_date: postingDate,
      purchase_receipt_id: receiptId,
      purchase_invoice_id: invoiceId,
      accountingDocumentId: invoiceAccountingDocumentId || receiptAccountingDocumentId,
      accountingDocumentIds,
      receipt_post_result: receiptPost,
      invoice_post_result: invoicePost,
      wiring: {
        purchaseReceipt: 'purchase_receipts schema bridge',
        purchaseInvoice: 'purchase_invoices schema bridge',
        glWriter: 'EW-01 PostingService.postAccountingDocument only',
        apLedger: 'ar_ap_ledger_entries supplier outstanding',
      },
    };
  } finally {
    await pool.end().catch(() => {});
  }
}
