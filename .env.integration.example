# These must be real UUIDs selected/inserted from the local PostgreSQL database.
# MD01_COMPANY_ID=<real UUID from DB>
# MD01_INVENTORY_ACCOUNT_ID=<real UUID from DB; account_subtype=merchandise_inventory>
# MD01_COGS_ACCOUNT_ID=<real UUID from DB; account_subtype=cogs>
# MD01_REVENUE_ACCOUNT_ID=<real UUID from DB; account_subtype=sales_revenue>
